# Postgres connection string (Supabase, Railway, Neon, etc.)
DATABASE_URL="postgresql://user:password@host:5432/lotrunner"

# Shared secret required in the x-admin-token header to hit admin-only routes.
# Replace with a real auth system (Clerk / NextAuth / Supabase Auth) before launch.
ADMIN_TOKEN="replace-with-a-long-random-string"

# Resend (transactional email) — quote sent / bid won / invoice ready notifications
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="quotes@lotrunner.example"

# Stripe — collecting deposits & final invoices (wire up in app/api/payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
